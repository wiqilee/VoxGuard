# ── VoxGuard Environment Variables ────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.

# ── Frontend (Vite) ──────────────────────────────────────────
# Set to "true" for Vercel demo deployment (no backend required)
VITE_DEMO_MODE=false

# Backend WebSocket URL (used when VITE_DEMO_MODE=false)
VITE_WS_URL=ws://localhost:8000/ws/session

# ── Backend (Python FastAPI) ──────────────────────────────────
# Get your key at: https://aistudio.google.com
GOOGLE_API_KEY=your_gemini_api_key_here

# Google Cloud project ID
GOOGLE_CLOUD_PROJECT=your_gcp_project_id

# Path to GCP service account JSON (for Cloud Run / Vertex AI)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Backend server config
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app

# ── Gemini model config ───────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash-native-audio
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
MAX_TOKENS=1024
