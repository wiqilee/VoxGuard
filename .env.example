# ── VoxGuard Environment Variables v1.0 ───────────────────
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.

# ── Frontend (Vite) ──────────────────────────────────────────
# Set to "true" for Vercel demo deployment (no backend required)
VITE_DEMO_MODE=false

# Backend WebSocket URL (used when VITE_DEMO_MODE=false)
# Local:      ws://localhost:8000/ws/session
# Cloud Run:  wss://your-backend-url.a.run.app/ws/session
VITE_WS_URL=ws://localhost:8000/ws/session

# [FIX #3] Gemini API key for frontend TTS in demo mode
# This enables natural Gemini TTS voice instead of browser SpeechSynthesis.
# Get your key at: https://aistudio.google.com
# The key is sent directly to Google's API from the browser.
# Without this key, demo mode falls back to browser TTS (robotic voice).
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# [FIX #3] TTS model for frontend demo (must match backend config)
VITE_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ── Backend (Python FastAPI) ──────────────────────────────────
# Get your key at: https://aistudio.google.com
GOOGLE_API_KEY=your_gemini_api_key_here

# Google Cloud project ID
GOOGLE_CLOUD_PROJECT=your_gcp_project_id

# Path to GCP service account JSON (for Cloud Run / Vertex AI)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Backend server config
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app

# ── Gemini model config ───────────────────────────────────────
# Audio streaming (real-time call analysis)
GEMINI_MODEL=gemini-2.5-flash-native-audio

# Vision + text analysis (screenshots, transcripts, psych scoring)
GEMINI_VISION_MODEL=gemini-2.5-flash

# TTS (natural voice for intervention alerts)
# Options: gemini-2.5-flash-preview-tts (recommended)
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

MAX_TOKENS=1024
